# ==============================================================================
# FIERROS — Variables de Entorno de Producción y Desarrollo
# ==============================================================================

# ─── Supabase Backend ───
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_privada
DATABASE_URL=postgresql://postgres:password@tu-host.supabase.com:5432/postgres

# ─── URL Base de la Aplicación ───
NEXT_PUBLIC_APP_URL=https://fierros.app

# ─── Mercado Pago Suscripciones (Producción) ───
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxx-xxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxx-xxxxxx
MERCADOPAGO_CLIENT_ID=xxxxxx
MERCADOPAGO_CLIENT_SECRET=xxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxx
MP_PLAN_ID=xxxxxx
MP_PRECIO_PLAN_MENSUAL=29900

# ─── Google Gemini AI (OCR de Cédula y Asistente Técnico) ───
GEMINI_API_KEY=AIzaSy...
GEMINI_MODELO=gemini-2.5-flash

# ─── Resend (Correos Transaccionales) ───
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Fierros <notificaciones@fierros.app>"

# ─── Cron Jobs (Protección de Endpoints Automáticos) ───
CRON_SECRET=clave_secreta_para_cron_jobs
