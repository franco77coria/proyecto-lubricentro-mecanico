# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Conexión a base de datos para scripts de verificación y migraciones locales
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ─── Mercado Pago SDK & CLI (mpcli) ───
# Autenticación con mpcli:
#   mpcli login --token APP_USR-...
# Verificación de cuenta activa:
#   npm run mp:whoami
# Listado de planes y suscripciones:
#   npm run mp:plans
#   npm run mp:subs

MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu_access_token_aqui
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-tu_public_key_aqui
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Clave secreta para validar la firma criptográfica HMAC SHA-256 del webhook
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_aqui

# ID del plan de suscripción recurrente en Mercado Pago (creado con mpcli subscription-plans create)
# Plan Taller Pro Mensual (.900 ARS/mes):
MP_PLAN_ID=4415303f600e4990bb659ca862e8aefb
MP_PRECIO_PLAN_MENSUAL=29900

# URL pública de la app (para redirección de back_url y webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
