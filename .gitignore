# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Scripts locales con credenciales embebidas.
# Nunca commitear nada que lleve la service_role key: saltea RLS por completo
# y con ella se lee y escribe todo, de todos los talleres.
/scripts/crear-usuario-admin.mjs

# Herramientas locales del desarrollador, ajenas a la app.
# kimi-proxy.js lleva una API key embebida y no debe versionarse.
/kimi-proxy.js
/start-claude-kimi.bat
/start-claude-kimi.ps1

# Prospección comercial B2B. Nada de esto es de la app: son scripts sueltos y
# una base de 550 empresas con teléfono, WhatsApp y email de contacto. Vivían
# sin trackear Y sin ignorar en la raíz, a un `git add .` de quedar publicados
# en un repo conectado a Vercel. Si el trabajo sigue, va en su propio repo.
/*.py
/__pycache__/
/cleaned_leads_raw.json
/raw_targeted_elements.json
/prospectos_empresas_argentina_*.csv
/prospectos_empresas_argentina_*.xlsx
